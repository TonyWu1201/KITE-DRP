# =============================================================================
# KITE-DRP 本机推理服务配置模板
#
# 用法：
#   Linux/macOS:        cp .env.example .env   （服务启动时自动读取 deploy/server/.env）
#   Windows PowerShell: Copy-Item .env.example .env
# 显式导出的同名环境变量优先于 .env 文件；.env 已被根 .gitignore 忽略，不要提交。
#
# 安全红线（计划书 §9.3 #10、§9.4）：
#   - KITE_SERVER_HOST 必须保持 127.0.0.1：仅允许医生站本机浏览器访问，
#     不要改成 0.0.0.0，本服务不提供任何认证/内网穿透/上报能力。
#   - 运行期不联网：不要把任何密钥、云服务地址写进这里。
# =============================================================================

# 监听地址与端口（默认仅回环地址）
KITE_SERVER_HOST=127.0.0.1
KITE_SERVER_PORT=8000

# 部署包目录：内含 manifest.json + model.onnx（由训练机 src/kite_drp/deploy 导出）。
# 相对路径以 deploy/server 为基准；留空（KITE_MODEL_DIR=）表示显式使用 demo 模式。
# 目录不存在/校验失败时服务会自动回退 demo 模式，并在 /health 中显式标记 demo=true。
KITE_MODEL_DIR=../packages/current

# 队列与并发：worker 数默认 1（单 worker 串行推理，便于端侧复现与限流）。
KITE_QUEUE_MAX=64
KITE_WORKERS=1

# 内存中保留的最近任务条数上限（重启清空；不写磁盘、不写输入数据到日志）
KITE_JOB_RETENTION=200

# 日志级别：DEBUG/INFO/WARNING/ERROR/CRITICAL
KITE_LOG_LEVEL=INFO

# 可选：指定其他 .env 文件路径（一般不需要）
# KITE_ENV_FILE=/absolute/path/to/kite-drp-server.env
